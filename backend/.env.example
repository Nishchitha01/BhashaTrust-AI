# QpiAI Quantum SDK / QCloud credential (distinct from QpiAI Opt credentials).
# Copy to backend/.env and set locally. Never place this value in frontend code.
API_KEY=

# QpiAI Opt platform credential. Remote solver requests also require explicit
# per-request confirmation and may consume credits.
QPIAI_OPT_API_KEY=

# Trusted evidence review is disabled until both server-side values are set.
# Use a random token with at least 32 characters; never expose it to the frontend bundle.
BHASHATRUST_REVIEWER_ID=
BHASHATRUST_REVIEWER_TOKEN=

# Phase 8 local Hardhat RPC only. No private key is needed: the backend sends
# with an unlocked account exposed by the local Hardhat node.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=hardhat-local
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SENDER_ADDRESS=
BLOCKCHAIN_TX_TIMEOUT=20
